# Local development only. Copy to .env (git-ignored). NEVER commit real values.
# In the cloud, secrets come from Secret Manager (see agent_app/config.py).

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Model routing
FLASH_MODEL=gemini-2.5-flash
PRO_MODEL=gemini-2.5-pro

# Persistence: leave AGENT_ENGINE_ID empty locally to use SQLite.
AGENT_ENGINE_ID=
SESSION_DB_URL=sqlite+aiosqlite:///./.adk/sessions.db

# Observability & privacy
ENABLE_CLOUD_DLP=false
ENABLE_CLOUD_TRACE=false
LOG_LEVEL=INFO

# Policy
CORP_EMAIL_DOMAIN=example.com
MAX_ACCESS_HOURS=8
MAX_HIGH_STAKES_ACTIONS=3

# Secrets are resolved from Secret Manager (ITSM_API_TOKEN, PAGER_WEBHOOK_URL).
# For offline local dev you may export them in your shell instead.
